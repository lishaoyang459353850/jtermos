# JTermOS 内核增量配置
# ==== 基础 ====
CONFIG_ARM64=y
CONFIG_SMP=y
CONFIG_PREEMPT_NONE=y
CONFIG_HZ_250=y

# ==== 启动/控制台 ====
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# ==== 文件系统 ====
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y

# ==== 网络 ====
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_SCSI=y
CONFIG_BLK_DEV=y
CONFIG_NETFILTER=n

# ==== Java/JVM 必需 ====
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_MEMFD_CREATE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_FHANDLE=y

# ==== framebuffer ====
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ==== MMC ====
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y

# ==== 体积优化 ====
CONFIG_KERNEL_GZIP=y
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_KERNEL=n
CONFIG_MODULES=n

# ==== 随机数 ====
CONFIG_RANDOM_TRUST_CPU=y
CONFIG_JITTERENTROPY=y